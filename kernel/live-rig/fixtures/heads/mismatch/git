#!/usr/bin/env python3
# A fake git for one test: it runs the real git, then after a fetch makes FETCH_HEAD name another commit, as a
# remote that answered with the wrong commit would.
import os, subprocess, sys
p = subprocess.run([os.environ['HEADS_REAL_GIT']] + sys.argv[1:])
if p.returncode == 0 and 'fetch' in sys.argv[1:]:
    root = sys.argv[sys.argv.index('-C') + 1] if '-C' in sys.argv else '.'
    git_dir = subprocess.run([os.environ['HEADS_REAL_GIT'], '-C', root, 'rev-parse', '--git-dir'],
                             capture_output=True, text=True, check=True).stdout.strip()
    with open(os.path.join(root, git_dir, 'FETCH_HEAD'), 'w') as f:
        f.write(os.environ['HEADS_OTHER_SHA'] + '\t\tsome other commit\n')
sys.exit(p.returncode)
