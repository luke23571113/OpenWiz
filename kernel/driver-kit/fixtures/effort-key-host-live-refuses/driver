#!/usr/bin/env python3
import importlib.machinery, importlib.util, os, sys
sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_loader('effortkey', importlib.machinery.SourceFileLoader(
    'effortkey', os.path.join(HERE, '..', 'effort-key-host', 'driver')))
k = importlib.util.module_from_spec(spec)
spec.loader.exec_module(k)
t, refuse = k.k.t, k.e.refuse


def live_refuse(t, req):
    if os.environ.get('OPENWIZ_HOSTKEY_TEST_ORIGIN') == os.environ.get('FAKE_LIVE_ORIGIN'):
        with open(os.environ['FAKE_LIVE_LOG'], 'a') as f:
            f.write('effort\n')
        raise t.Refused('the host has no effort %s for harness %s' % (req['effort'], req['harness']),
                        'start it again without the effort')
    refuse(t, req)


k.e.refuse = live_refuse
t.main()
