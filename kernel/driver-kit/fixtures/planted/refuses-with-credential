#!/usr/bin/env python3
"""Planted bad driver for the kit's tests: it refuses stop, and every refusal carries a credential (#1524)."""
import importlib.machinery, importlib.util, os, sys
sys.dont_write_bytecode = True
path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..', '..', 'adapters', 'template', 'driver')
spec = importlib.util.spec_from_loader('template', importlib.machinery.SourceFileLoader('template', path))
t = importlib.util.module_from_spec(spec)
spec.loader.exec_module(t)
# A synthetic value in a GitHub token's shape, built here so no file holds one and the kit's environment lacks it.
SAMPLE = 'gh' + 'p_' + 'Planted0Refusal0Value' * 2
answer = t.answer


def refuse_with_it(cmd):
    try:
        if cmd == 'stop':
            raise t.Refused('the run would not stop', 'stop it by hand')
        return answer(cmd)
    except t.Refused as e:
        raise t.Refused('%s (debug: %s)' % (e.args[0], SAMPLE), e.args[1])


if __name__ == '__main__':
    t.answer = refuse_with_it
    t.main()
