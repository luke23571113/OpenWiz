#!/usr/bin/env python3
import json, os, sys, time
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake auggie (its forms follow `auggie --help` 1.2.2, in evidence/): it allows only
  auggie -p --mode json --model <m> <prompt>
  auggie --session <id> -p --mode json --model <m> <prompt>
where <id> is a session id, never a path (no "/" or "\\", not ending in .jsonl). It has no --thinking:
the row declares effort none. With FAKE_CLI_SIGNED_OUT=1 it answers as 1.2.2 does when signed out.'''


def header(sid):
    return json.dumps({'type': 'session', 'version': 3, 'id': sid,
                       'timestamp': time.strftime('%Y-%m-%dT%H:%M:%S.000Z', time.gmtime()), 'cwd': os.getcwd()})


if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
a, session = sys.argv[1:], None
if a[:1] == ['--session'] and len(a) > 1:
    session, a = a[1], a[2:]
    if '/' in session or '\\' in session or session.endswith('.jsonl') or not session:
        fake_cli.refuse()
if len(a) != 6 or a[:3] != ['-p', '--mode', 'json'] or a[3] != '--model' or a[5].startswith('-'):
    fake_cli.refuse()
model, prompt = a[4], a[5]
if (session is not None) != prompt.startswith('You were woken'):
    fake_cli.refuse()
if os.environ.get('FAKE_CLI_SIGNED_OUT'):
    print(header(session or '00000000-0000-4000-8000-0000000000b2'), flush=True)
    print('No API key found for unknown.', file=sys.stderr, flush=True)
    sys.exit(1)
fake_cli.turn(prompt, model, session, header, daemon='tree')
