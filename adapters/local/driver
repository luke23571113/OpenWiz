#!/usr/bin/env python3
"""The local driver (kernel/driver.v1.md): runs builders on the machine it runs on, a laptop or a VPS.

Each turn of a run is one local process of a harness the person has already signed into: `start` runs
the first turn, `wake` another, `stop` ends every process the run started. Several runs at once are
independent. It never reads, passes or prints a login. Linux; Python 3.11 or later; standard library only.
"""
import fcntl, json, os, re, secrets, shutil, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_LOCAL_STATE') or os.path.expanduser('~/.local/state/openwiz-local')
VERSION = {'driver': 'local', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'many-at-once']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'run-[0-9a-f]{12}'}
# Each harness's own non-interactive command. It adds no login, token or permission flag: the
# person's own sign-in and settings for that harness decide what its agent may do.
HARNESSES = {'claude': lambda model, prompt: ['-p', prompt, '--model', model],
             'codex': lambda model, prompt: ['exec', '--model', model, prompt]}
GRACE = 10  # seconds a stopped process has to exit before it is killed


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    """The request on stdin, with exactly these fields, each valid, or Refused."""
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def program(harness):
    """The harness's absolute path on this machine, or Refused."""
    if harness not in HARNESSES:
        raise Refused('harness %s is not one this driver runs' % harness, 'use one of: ' + ', '.join(HARNESSES))
    path = shutil.which(harness)
    if not path:
        raise Refused('harness %s is not installed here' % harness,
                      'install %s on this machine and sign in to it yourself, then start again' % harness)
    return path


def prompt(req, woken):
    where = '%s#%d' % (req['repository'], req['ticket'])
    if woken:
        return ('You were woken: take up %s again, with the %s skill. Edit your own status note there; '
                'post no second one.' % (where, req['skill']))
    return 'Build the ticket: %s, with the %s skill. Keep one status note there.' % (where, req['skill'])


def launch(state, run, woken):
    """Start one turn as its own session, with the person's environment and this run's mark; its pid."""
    req = state['request']
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    log = os.open(os.path.join(STATE, run + '.log'), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        return subprocess.Popen([state['program']] + HARNESSES[req['harness']](req['model'], prompt(req, woken)),
                         env=dict(os.environ, OPENWIZ_RUN=run), start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log).pid
    except OSError as e:
        raise Refused('harness %s did not start: %s' % (req['harness'], e.strerror),
                      'run %s by hand once to check it works, then start again' % req['harness'])
    finally:
        os.close(log)


def processes(run):
    """Every live process carrying this run's mark: its turns and anything they started."""
    mark = ('OPENWIZ_RUN=' + run).encode()
    found = []
    for pid in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/environ' % pid, 'rb') as f:
                if mark in f.read().split(b'\0'):
                    found.append(int(pid))
        except OSError:
            pass
    return found


def end(run):
    """Signal each of the run's processes, rechecking its mark first so a reused pid is never hit."""
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, 2)):
        deadline = time.monotonic() + wait
        for pid in processes(run):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
        while processes(run) and time.monotonic() < deadline:
            time.sleep(0.1)
        if not processes(run):
            return
    raise Refused('run %s still has processes after stop' % run, 'stop it again, or end them by hand')


class Saved:
    """One run's saved state, locked for the whole command so a wake and a stop never interleave."""

    def __init__(self, run):
        self.path = os.path.join(STATE, run + '.json')
        if not os.path.exists(self.path):
            raise Refused('no run ' + run, 'check the run id that `driver start` printed')
        self.lock = open(self.path + '.lock', 'a')
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        with open(self.path) as f:
            self.state = json.load(f)


def save(path, state):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    with open(path + '.new', 'w') as f:
        json.dump(state, f)
    os.replace(path + '.new', path)


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req = read(START)
        run, state = 'run-' + secrets.token_hex(6), {'request': req, 'program': program(req['harness']),
                                                    'stopped': False}
        path = os.path.join(STATE, run + '.json')
        save(path, state)
        try:
            save(path, dict(state, turn=launch(state, run, False)))
        except Refused:
            save(path, dict(state, stopped=True))
            raise
        return {'run': run}
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        saved = Saved(run)
        if cmd == 'stop':
            save(saved.path, dict(saved.state, stopped=True))
            end(run)
            return {'run': run, 'stopped': True}
        if saved.state['stopped']:
            raise Refused('run %s is stopped' % run, 'start a new run')
        # One agent per ticket: while the run's last turn still runs, that agent is already awake and
        # will read the ticket again itself, so the wake starts no second turn (#1469).
        if saved.state.get('turn') not in processes(run):
            save(saved.path, dict(saved.state, turn=launch(saved.state, run, True)))
        return {'run': run, 'woke': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
