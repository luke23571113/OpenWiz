#!/usr/bin/env python3
"""A synthetic harness for the local driver's tests, run through a link named `claude` or `codex`.

It takes only the shape that harness's real CLI takes (`claude -p <prompt> --model <m>`,
`codex exec --model <m> <prompt>`) and exits 2 on any other. Then, like the kit's fake harness,
it posts (or, when woken, edits) one builder status note in the tracker named by KIT_TRACKER, and
leaves a detached child in its own session that `stop` must also end.
"""
import json, os, re, subprocess, sys, time

name, args = os.path.basename(sys.argv[0]), sys.argv[1:]
if name == 'claude' and len(args) == 4 and args[0] == '-p' and args[2] == '--model':
    prompt, model = args[1], args[3]
elif name == 'codex' and len(args) == 4 and args[:2] == ['exec', '--model']:
    model, prompt = args[2], args[3]
else:
    sys.exit(2)
skill = re.search(r'with the ([a-z0-9-]+) skill', prompt).group(1)
woken = prompt.startswith('You were woken')
subprocess.Popen(['sleep', '120'], start_new_session=True)
now = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
body = '\n'.join(['<!-- openwiz:status v1 -->', 'agent: builder', 'state: working', 'harness: Fake',
                  'model: ' + model, 'skills: %s@0.1.2' % skill,
                  'step: ' + ('woke and read the ticket again' if woken else 'started the throwaway ticket'),
                  'time: ' + now]) + '\n'
path = os.environ['KIT_TRACKER']
with open(path) as f:
    tracker = json.load(f)
mine = [c for c in tracker['comments'] if c['author'] == 'example-bot[bot]' and 'agent: builder' in c['body']]
if woken:
    mine[-1].update(body=body, updated_at=now)
else:
    tracker['comments'].append({'id': 1 + max([c['id'] for c in tracker['comments']], default=0),
                                'author': 'example-bot[bot]', 'updated_at': now, 'body': body})
with open(path + '.%d' % os.getpid(), 'w') as f:
    json.dump(tracker, f)
os.replace(path + '.%d' % os.getpid(), path)
time.sleep(120)
