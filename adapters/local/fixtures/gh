#!/usr/bin/env python3
"""A synthetic `gh` for the local driver's tests: `gh repo clone <owner>/<name> <folder>` copies the folder
FAKE_REPOS/<owner>/<name>. Any other call, or a repository it doesn't have, fails as gh does, on stderr."""
import os, shutil, sys

args = sys.argv[1:]
if len(args) != 4 or args[:2] != ['repo', 'clone']:
    sys.exit('fake gh: only `gh repo clone <repo> <folder>` is supported')
source = os.path.join(os.environ['FAKE_REPOS'], args[2])
if not os.path.isdir(source):
    sys.exit('GraphQL: Could not resolve to a Repository with the name \'%s\'. (repository)' % args[2])
shutil.copytree(source, args[3])
