#!/usr/bin/env python3
"""The boat.dev driver (kernel/driver.v1.md): each run is one boat.dev sandbox and one agent conversation in it.

`start` creates a sandbox (`boat new`) and prompts its integrated agent in a new conversation; `wake`
resumes the sandbox if boat stopped it and prompts that conversation again, once the last turn has ended;
`stop` ends every local process the turns started, interrupts the agent and stops the sandbox (`boat stop`
keeps its disk). Each turn is a local `boat prompt` under its own supervisor, which keeps every process the
turn starts. A run is saved before anything is started for it, stays `starting` until its first turn is
saved, and a wake or a stop holds the run's lock throughout. It calls only the user's own signed-in `boat`
CLI and never reads a login. Linux; standard library only.
"""
import ctypes, fcntl, json, os, re, secrets, shutil, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_BOAT_STATE') or os.path.expanduser('~/.local/state/openwiz-boat')
VERSION = {'driver': 'boat', 'records': ['openwiz:records v1'],
           'can': ['start', 'wake', 'stop', 'many-at-once', 'own-sandbox']}
# The agent harnesses boat runs with `boat prompt --provider` (docs.boat.dev, 2026-11-19).
HARNESSES = ('claude', 'codex', 'pi', 'opencode', 'prime', 'kimi', 'mistral')
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'run-[0-9a-f]{12}'}
ID = re.compile(r'[A-Za-z0-9_.:-]{1,100}')
QUEUED_WAIT = 60  # seconds for boat to queue a turn; the kit gives a command 120
GRACE = 10  # seconds a stopped process has to exit before it is killed
UNWRITABLE = 'make OPENWIZ_BOAT_STATE (or ~/.local/state/openwiz-boat) a folder you can write'


class Refused(Exception):
    pass


def line(text):
    """One line of at most 300 characters, as driver v1's errors need."""
    text = ' '.join(str(text).split()) or 'no detail'
    return text if len(text) <= 300 else text[:297] + '...'


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    """The request on stdin, with exactly these fields, each valid, or Refused."""
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def boat_program():
    found = shutil.which('boat')
    if not found:
        raise Refused('the boat CLI is not installed here',
                      'install it (curl -fsSL https://boat.dev/install | sh) and sign in to it yourself first')
    return found


def boat_error(what, lines, stderr, then):
    """Refused, from boat's last `{"event": "error"}` line or its output; `then` is the step after the fix."""
    errors = [x for x in lines if x.get('event') == 'error']
    detail = '%s (%s)' % (errors[-1].get('error'), errors[-1].get('code')) if errors else stderr or 'no answer'
    if 'provider_not_configured' in detail:
        step = "connect that harness's key or subscription in boat's dashboard (Agents & Proxying) yourself"
    elif re.search(r'sign|login|auth|401', detail, re.I):
        step = 'sign in to boat yourself with `boat login`'
    else:
        step = 'fix what boat said'
    return Refused(line('boat %s failed: %s' % (what, detail)), line('%s, then %s' % (step, then)))


def parse(text):
    found = []
    for raw in text.splitlines():
        try:
            item = json.loads(raw)
        except ValueError:
            continue
        if isinstance(item, dict):
            found.append(item)
    return found


def boat(then, *args):
    """Run one `boat ... --json` command to its end; its JSON lines, or Refused."""
    try:
        p = subprocess.run([boat_program()] + list(args) + ['--json'], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=100)
    except subprocess.TimeoutExpired:
        raise Refused('boat %s took too long; its outcome is unknown' % args[0],
                      'check `boat list --all`, then %s' % then)
    lines = parse(p.stdout)
    if p.returncode != 0 or any(x.get('event') == 'error' for x in lines):
        raise boat_error(args[0], lines, p.stderr.strip()[-200:], then)
    return lines


def prompt_text(req, woken):
    what = 'You were woken: read the ticket again and carry on' if woken else 'Build the ticket'
    return ('%s: GitHub repository %s, ticket #%d, with the %s skill. Clone the repository if it is not here '
            'yet, and follow its instructions.' % (what, req['repository'], req['ticket'], req['skill']))


def path(run, name):
    return os.path.join(STATE, '%s.%s' % (run, name))


def since(pid):
    """When process pid started, or None once it has exited: with its pid, this names one process."""
    try:
        with open('/proc/%d/stat' % pid) as f:
            fields = f.read().rpartition(')')[2].split()
    except OSError:
        return None
    return None if fields[0] == 'Z' else int(fields[19])


def descendants(pid):
    """Every live process under pid."""
    children = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/stat' % p) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if fields[0] != 'Z':
            children.setdefault(int(fields[1]), []).append(int(p))
    found, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return found


def supervise(log, cmd):
    """One turn, as `driver --turn <log> <boat prompt ...>`: run it with its output in log, and keep every
    process it starts as this turn's (an orphan comes back here, whatever its session or environment) until
    none is left; then exit."""
    if ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        print(json.dumps({'error': "this host cannot keep a turn's processes together"}), flush=True)
        return
    try:
        with open(log, 'a') as out:
            turn = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
    except OSError as e:
        print(json.dumps({'error': e.strerror}), flush=True)
        return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)  # only `end` stops a turn, and it never orphans one
    print(json.dumps({'pid': turn.pid, 'since': since(turn.pid)}), flush=True)
    os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
    while True:
        try:
            os.wait()
        except ChildProcessError:
            return


def running(turn):
    """Whether the turn's `boat prompt` still runs: boat ends it when the agent's turn ends."""
    return bool(turn) and turn['since'] is not None and since(turn['pid']) == turn['since']


def end(turns, run):
    """End every process the turns' supervisors still keep, whatever its session or environment.
    A supervisor exits only once none of its processes is left, so this returns once every one has exited."""
    kept = [(t['supervisor'], t['supervisor_since']) for t in turns if t and t['supervisor_since'] is not None]
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, 2)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            kept = [(p, t) for p, t in kept if since(p) == t]
            if not kept:
                return
            pinned = {}
            for p in set().union(*(descendants(s) for s, _ in kept)) - sent:
                try:  # pin each pid first, then check it is still under a supervisor, so no reused pid is hit
                    pinned[p] = os.pidfd_open(p)
                except OSError:
                    pass
            under = set().union(*(descendants(s) for s, _ in kept))
            for p, fd in pinned.items():
                try:
                    if p in under:
                        sent.add(p)
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has local processes after stop' % run,
                  'stop it again, or end its processes by hand: they run under process %s'
                  % ', '.join(str(p) for p, _ in kept))


def prompt(state, run):
    """Start one turn: `boat prompt` under its supervisor, then wait until boat queues it.
    Returns (turn, conversation); saves nothing. If boat never queues it, the turn is ended and Refused."""
    req, woken = state['request'], bool(state['turns'])
    args = [boat_program(), 'prompt', state['sandbox']]
    args += ['--resume', state['conversation']] if woken else ['--new']
    args += ['--provider', req['harness'], '--model', req['model'], '--json', prompt_text(req, woken)]
    log = path(run, '%d.log' % len(state['turns']))
    os.close(os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600))
    then = 'wake it again' if woken else 'start again'
    try:
        sup = subprocess.Popen([sys.executable, '-I', os.path.abspath(__file__), '--turn', log] + args,
                               env=dict(os.environ, OPENWIZ_RUN=run), start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        with sup.stdout:
            first = sup.stdout.readline()
    except OSError as e:
        raise Refused('boat prompt did not start: %s' % e.strerror, 'check that `boat` runs by hand, then ' + then)
    try:
        started = json.loads(first)
    except ValueError:
        started = {'error': 'its supervisor did not answer'}
    if 'pid' not in started:
        raise Refused('boat prompt did not start: %s' % started['error'], 'check that `boat` runs by hand, then ' + then)
    turn = {'pid': started['pid'], 'since': started['since'], 'supervisor': sup.pid,
            'supervisor_since': since(sup.pid)}
    deadline = time.monotonic() + QUEUED_WAIT
    while True:
        ended = not running(turn)  # before the read, so a turn that queued and ended is still seen queued
        with open(log) as f:
            text = f.read()
        lines = parse(text)
        queued = [conversation(x) for x in lines if x.get('event') == 'queued' and conversation(x)]
        if queued:
            return turn, queued[0]
        if ended:  # boat refused the prompt: nothing was queued
            end([turn], run)
            raise boat_error('prompt', lines, text.strip()[-200:], then)
        if time.monotonic() > deadline:
            end([turn], run)
            raise Refused('boat did not queue the turn within %d seconds; its outcome is unknown' % QUEUED_WAIT,
                          'check `boat conversations %s` for it, then stop the run' % state['sandbox'])
        time.sleep(0.1)


def text_id(value):
    """value, if it is a string id; else None."""
    return value if isinstance(value, str) and ID.fullmatch(value) else None


def conversation(item):
    """The conversation id of a `boat prompt --json` line: under `data`, as boat CLI 1.0.103 prints it."""
    data = item.get('data')
    return text_id(data.get('conversationId')) if isinstance(data, dict) else None


def sandbox_state(sandbox):
    info = [x for x in boat('stop the run', 'info', sandbox) if 'state' in x]
    return str(info[-1]['state']) if info else 'unknown'


def end_sandbox(sandbox, conversation):
    """Interrupt the agent and stop the sandbox. The stop is always tried, whatever `boat info` says or whether
    it answers; a failed stop is let pass only when `boat info` then shows the sandbox stopped. Else Refused."""
    if conversation:
        try:
            boat('stop the run again', 'interrupt', sandbox)
        except Refused:
            pass  # the stop below ends the agent's work too
    try:
        boat('stop the run again', 'stop', sandbox)
    except Refused:
        try:
            confirmed = sandbox_state(sandbox) in ('stopped', 'archived')
        except Refused:
            confirmed = False
        if not confirmed:
            raise


def saved(run, state=None):
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path(run, 'json.new'), 'w') as f:
            json.dump(state, f)
        os.replace(path(run, 'json.new'), path(run, 'json'))
        return state
    try:
        with open(path(run, 'json')) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def lock(run, create):
    """Hold the run's lock until this command ends, so its wakes and stops take turns. Only a stop makes a
    missing lock file again: a wake refuses a run without one (it may hold a stop's mark that was lost)."""
    if not os.path.exists(path(run, 'json')):
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')
    if not create and not os.path.exists(path(run, 'lock')):
        raise Refused('run %s has lost its lock file, which may have marked a stop' % run,
                      'stop it, then start a new run')
    try:
        fcntl.flock(os.open(path(run, 'lock'), os.O_RDONLY | (os.O_CREAT if create else 0), 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run, UNWRITABLE)


STOP_MARK = 1  # the lock file's mtime, in seconds since 1970, once a stop of the run has begun


def mark_stopping(run):
    """Record the stop intent on the run's existing lock file, so it lasts when the run's record can't be
    saved: by its content, and by its mtime, which its owner can set even when the file can't be written.
    Neither needs a new entry in the folder (a blocked save, a read-only folder). True if either worked."""
    marked = False
    try:
        fd = os.open(path(run, 'lock'), os.O_WRONLY | os.O_TRUNC)
        try:
            marked = os.write(fd, b'stopping\n') == 9
        finally:
            os.close(fd)
    except OSError:
        pass
    try:
        os.utime(path(run, 'lock'), (STOP_MARK, STOP_MARK))
        marked = True
    except OSError:
        pass
    return marked


def stopping(run):
    """Whether a stop of this run began and never saved that the run is stopped: either mark, or no lock."""
    try:
        with open(path(run, 'lock'), 'rb') as f:
            return f.read(9) == b'stopping\n' or os.fstat(f.fileno()).st_mtime == STOP_MARK
    except FileNotFoundError:
        return True


def strays(run, known):
    """This run's turn supervisors on this machine that its record doesn't name: a turn begun by a command
    that then failed before it could save it. Found by the run's mark and the `--turn` argument."""
    found = []
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/environ' % p, 'rb') as f:
                mine = ('OPENWIZ_RUN=' + run).encode() in f.read().split(b'\0')
            with open('/proc/%s/cmdline' % p, 'rb') as f:
                turn = f.read().split(b'\0')[3:4] == [b'--turn']
        except OSError:
            continue
        if mine and turn and int(p) not in known and since(int(p)) is not None:
            found.append({'supervisor': int(p), 'supervisor_since': since(int(p))})
    return found


def abandon(run, state, cmd, error):
    """After a start or a wake failed: end the turn it may have begun; after a start, also stop the sandbox
    (a wake interrupts its conversation instead). Returns None if that worked, else what to answer instead
    of error: the sandbox's stop is never left unreported."""
    what = error.args[0] if isinstance(error, Refused) else 'the driver failed: ' + type(error).__name__
    try:
        end(strays(run, {t['supervisor'] for t in state['turns']}), run)
    except Refused as e:
        return Refused(line('%s; %s' % (what, e.args[0])), e.args[1])
    if cmd == 'start':
        try:
            end_sandbox(state['sandbox'], state['conversation'])
        except Refused as e:
            return Refused(line('%s; and its sandbox %s may still run: %s' % (what, state['sandbox'], e.args[0])),
                           'run `boat stop %s` yourself, and check `boat list`' % state['sandbox'])
        try:
            saved(run, dict(state, stopped=True))
        except OSError:
            pass  # still `starting`: a wake refuses it
    elif state['conversation']:
        try:
            boat('stop the run', 'interrupt', state['sandbox'], '--convo', state['conversation'])
        except Refused as e:
            return Refused(line('%s; and its conversation may still run: %s' % (what, e.args[0])),
                           'run `boat interrupt %s` yourself, then stop the run' % state['sandbox'])
    return None


def unsaved(run, sandbox, turn, conversation, cmd):
    """A turn began but could not be saved: end it here and in the sandbox, and say the outcome is unknown,
    never to do it again. After a start, the sandbox is stopped too: the run never finished starting."""
    try:
        end([turn], run)
        if cmd == 'start':
            end_sandbox(sandbox, conversation)
        else:
            boat('stop the run', 'interrupt', sandbox, '--convo', conversation)
    except Refused:
        raise Refused(line('run %s began a turn it could not save, and could not confirm the turn ended; its '
                           'outcome is unknown' % run),
                      line('run `boat stop %s` and end process %d and everything under it by hand, and read the '
                           'ticket for what its agent did, before you start a new run' % (sandbox, turn['supervisor'])))
    raise Refused('run %s began a turn it could not save, so the driver ended it; its outcome is unknown' % run,
                  'read the ticket for what its agent did before you %s' % (
                      'start a new run' if cmd == 'start' else 'wake it again'))


def start(req):
    if req['harness'] not in HARNESSES:
        raise Refused('boat has no harness %s' % req['harness'], 'use one of: ' + ', '.join(HARNESSES))
    boat_program()
    run = 'run-' + secrets.token_hex(6)
    state = {'request': req, 'sandbox': None, 'conversation': None, 'turns': [],
             'stopped': False, 'starting': True}  # never woken while starting; a stop still reaches it
    try:  # save the run before anything starts: nowhere to keep it, nothing starts
        saved(run, state)
        os.close(os.open(path(run, 'lock'), os.O_WRONLY | os.O_CREAT, 0o600))
    except OSError:
        raise Refused('the driver cannot save runs in its state folder; nothing was started', UNWRITABLE)
    try:
        ready = [x for x in boat('start again', 'new', '--name', 'openwiz-' + run) if x.get('event') == 'ready']
    except Refused as e:
        raise Refused(e.args[0], line(e.args[1] + '; if `boat list` shows a sandbox named openwiz-%s, stop it '
                                                  'first' % run))
    if not ready or not text_id(ready[-1].get('id')):
        raise Refused('boat new gave no sandbox id', 'stop the sandbox named openwiz-%s in `boat list` yourself, '
                                                     'then start again' % run)
    state['sandbox'] = ready[-1]['id']
    try:  # from here on the sandbox exists: any failure ends its turn and stops it
        try:
            saved(run, state)
        except OSError:
            end_sandbox(state['sandbox'], None)
            raise Refused('the driver cannot save run %s, so it stopped its new sandbox; nothing runs' % run,
                          UNWRITABLE + ', then start again')
        turn, talk = prompt(state, run)
        try:
            saved(run, dict(state, turns=[turn], conversation=talk, starting=False))
        except OSError:  # the turn began but its run is not saved: end it, and never say do it again
            unsaved(run, state['sandbox'], turn, talk, 'start')
    except Exception as e:
        instead = abandon(run, state, 'start', e)
        if instead:
            raise instead from e
        raise
    return {'run': run}


def wake(run):
    lock(run, False)
    state = saved(run)
    if state['stopped']:
        raise Refused('run %s is stopped' % run, 'start a new run')
    if stopping(run):
        raise Refused('a stop of run %s could not save that the run is stopped' % run,
                      'stop it again; it stays stopped and is never woken')
    if state.get('starting'):
        raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
    # One agent per run: while its last turn runs, that agent is awake and reads the ticket itself.
    if state['turns'] and running(state['turns'][-1]):
        return {'run': run, 'woke': True}
    try:  # a turn it could not save would be beyond a later wake's check: save first, or start nothing
        saved(run, state)
    except OSError:
        raise Refused('the driver cannot save run %s; nothing was started' % run, UNWRITABLE + ', then wake it')
    now = sandbox_state(state['sandbox'])
    if now in ('stopped', 'archived'):
        boat('wake it again', 'resume', state['sandbox'])
    elif now in ('stopping', 'archiving'):
        raise Refused('the sandbox of run %s is still stopping' % run, 'wake it again in a minute')
    try:
        turn, _ = prompt(state, run)
        try:
            saved(run, dict(state, turns=state['turns'] + [turn]))
        except OSError:
            unsaved(run, state['sandbox'], turn, state['conversation'], 'wake')
    except Refused:
        raise  # prompt and unsaved have already ended what they began
    except Exception as e:
        instead = abandon(run, state, 'wake', e)
        if instead:
            raise instead from e
        raise
    return {'run': run, 'woke': True}


def stop(run):
    lock(run, True)
    state = saved(run)
    marked = mark_stopping(run)  # first, so no later wake undoes this stop even if the save below fails
    try:  # before ending anything, so no wake starts a turn meanwhile
        saved(run, dict(state, stopped=True))
        kept = True
    except OSError:
        kept = False
    end(state['turns'], run)  # whether or not that save worked
    if state['sandbox']:
        end_sandbox(state['sandbox'], state['conversation'])
    for name in os.listdir(STATE):
        if name.startswith(run + '.') and name.endswith('.log'):
            try:
                os.remove(os.path.join(STATE, name))
            except OSError:
                pass
    if not kept:
        raise Refused('run %s has ended, but the driver could not save that it is stopped%s' % (
                          run, '' if marked else ', nor mark it stopping: do not wake it'),
                      UNWRITABLE + ', then stop it again')
    return {'run': run, 'stopped': True}


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        return start(read(START))
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        return wake(run) if cmd == 'wake' else stop(run)
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    if len(sys.argv) > 3 and sys.argv[1] == '--turn':
        return supervise(sys.argv[2], sys.argv[3:])
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__,
                     'next': 'read its code and fix it; check `boat list` for what is running'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
