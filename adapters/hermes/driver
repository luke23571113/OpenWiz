#!/usr/bin/env python3
"""The OpenWiz driver for Hermes (kernel/driver.v1.md), through Hermes' own signed-in `hermes` CLI.

Each turn of a run is one `hermes chat --oneshot --format stream-json` under its own supervisor, which keeps every
process the turn starts: `start` runs the first turn and keeps the Hermes session id it reports, `wake` runs
another with `--resume <session>` once the last one has ended, and `stop` interrupts the turn (SIGINT, Hermes'
Ctrl-C) and then ends everything the turns started. A run is saved before its first turn starts, and a wake or a
stop holds the run's lock throughout. Hermes reads its own configuration: the driver never reads, sends or prints
a key. Built from adapters/template/. Linux; standard library only.
"""
import ctypes, fcntl, json, os, re, secrets, shutil, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_HERMES_STATE') or os.path.expanduser('~/.local/state/openwiz-hermes')
VERSION = {'driver': 'hermes', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'run-[0-9a-f]{12}'}
GRACE = 10  # seconds a stopped process has to exit before it is killed
SETTLE = 10  # seconds an interrupted Hermes turn has to settle cancelled before it is ended
SESSION_WAIT = 60  # seconds a new turn has to report its Hermes session
# harness -> the bundled Hermes skill that runs it (None: Hermes is the harness itself)
HARNESSES = {'claude': 'claude-code', 'codex': 'codex', 'hermes': None}
SESSION = r'[A-Za-z0-9][A-Za-z0-9._:-]{0,199}'


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    """The request on stdin, with exactly these fields, each valid, or Refused."""
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def command(req, session):
    """Hermes' own signed-in CLI, one turn: a new session, or `--resume` the run's session. Never a login or a key.
    For `hermes`, `model` is Hermes' model; for `claude` or `codex`, Hermes keeps its own model and runs that CLI
    through its bundled skill, told in the prompt to use `model`."""
    what = 'You were woken: read the ticket again and carry on' if session else 'Build the ticket'
    prompt = '%s: %s#%d, with the %s skill.' % (what, req['repository'], req['ticket'], req['skill'])
    cmd = ['hermes', 'chat', '--oneshot', '--format', 'stream-json', '--source', 'tool']
    tool = HARNESSES[req['harness']]
    if tool:
        cmd += ['-s', tool]
        prompt += (' Do the work through your %s skill: run the %s CLI with the model %s, and have it run the '
                   '%s skill there.' % (tool, req['harness'], req['model'], req['skill']))
    else:
        cmd += ['-m', req['model']]
    return cmd + (['--resume', session] if session else []) + ['-q', prompt]


def since(pid):
    """When process pid started, or None once it has exited: with its pid, this names one process."""
    try:
        with open('/proc/%d/stat' % pid) as f:
            fields = f.read().rpartition(')')[2].split()
    except OSError:
        return None
    return None if fields[0] == 'Z' else int(fields[19])


def descendants(pid):
    """Every live process under pid."""
    children = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/stat' % p) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if fields[0] != 'Z':
            children.setdefault(int(fields[1]), []).append(int(p))
    found, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return found


def supervise(out, cmd):
    """One turn, as `driver --turn <log> <command>`: run the harness, and keep every process it starts as this turn's
    (an orphan comes back here, whatever its session or environment) until none is left; then exit."""
    if ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        print(json.dumps({'error': 'this host cannot keep a turn\'s processes together'}), flush=True)
        return
    try:
        with open(out, 'ab') as log:
            harness = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.DEVNULL)
    except OSError as e:
        print(json.dumps({'error': e.strerror}), flush=True)
        return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)  # only `end` stops a turn, and it never orphans one
    print(json.dumps({'pid': harness.pid, 'since': since(harness.pid)}), flush=True)
    os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
    while True:
        try:
            os.wait()
        except ChildProcessError:
            return


def turn_log(run, n):
    return os.path.join(STATE, '%s.%d.log' % (run, n))


def reported_session(path):
    """The session id the turn's `system` `init` line reports, or None so far."""
    try:
        with open(path) as f:
            for line in f:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if isinstance(event, dict) and event.get('type') == 'system' and event.get('subtype') == 'init':
                    sid = event.get('session_id')
                    return sid if isinstance(sid, str) and re.fullmatch(SESSION, sid) else ''
    except OSError:
        pass
    return None


def launch(req, run, session, n):
    """Start turn n under its supervisor, its output in the run's owner-only log; return what `running` and `end`
    need, and for a first turn the Hermes session it reports."""
    if not shutil.which('hermes'):
        raise Refused('hermes is not installed here',
                      'install Hermes and set up its model yourself (hermes setup), then start again')
    out = turn_log(run, n)
    try:
        os.close(os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600))
    except OSError:
        raise Refused('the driver cannot write run %s\'s log in its state folder; nothing was started' % run,
                      'make OPENWIZ_HERMES_STATE (or ~/.local/state/openwiz-hermes) a folder you can write')
    try:
        sup = subprocess.Popen([sys.executable, '-I', os.path.abspath(__file__), '--turn', out]
                               + command(req, session),
                               env=dict(os.environ, OPENWIZ_RUN=run), start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        with sup.stdout:
            line = sup.stdout.readline()
    except OSError as e:
        raise Refused('hermes did not start: %s' % e.strerror, 'check that `hermes chat` runs by hand')
    try:
        turn = json.loads(line)
    except ValueError:
        turn = {'error': 'its supervisor did not answer'}
    if 'pid' not in turn:
        raise Refused('hermes did not start: %s' % turn['error'], 'check that `hermes chat` runs by hand')
    turn = {'pid': turn['pid'], 'since': turn['since'], 'supervisor': sup.pid, 'supervisor_since': since(sup.pid),
            'log': out, 'session': session}
    if session:
        return turn
    deadline = time.monotonic() + SESSION_WAIT
    while time.monotonic() < deadline:  # a run needs its session before it can be woken
        turn['session'] = reported_session(out)
        if turn['session'] is not None or not running(turn, run):
            break
        time.sleep(0.1)
    if not turn['session']:
        end([turn], run)
        raise Refused('hermes did not report a session for run %s, so the driver ended its turn' % run,
                      'run `hermes chat --oneshot -q hello` by hand to see why, then start again')
    return turn


def running(turn, run):
    """Whether the turn `launch` returned still runs its harness."""
    return bool(turn) and turn['since'] is not None and since(turn['pid']) == turn['since']


def end(turns, run):
    """Stop the run: interrupt its Hermes turn as Ctrl-C would, so it settles cancelled, then end every process its
    turns' supervisors still keep, whatever its session or environment. A supervisor exits only once none of its
    processes is left, so answer once every supervisor has exited."""
    kept = [(t['supervisor'], t['supervisor_since']) for t in turns if t and t['supervisor_since'] is not None]
    for sig, wait in ((signal.SIGINT, SETTLE), (signal.SIGTERM, GRACE), (signal.SIGKILL, 2)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            kept = [(p, t) for p, t in kept if since(p) == t]
            if not kept:
                return
            pinned = {}
            for p in set().union(*(descendants(s) for s, _ in kept)) - sent:
                try:  # pin each pid first, then check it is still under a supervisor, so no reused pid is hit
                    pinned[p] = os.pidfd_open(p)
                except OSError:
                    pass
            under = set().union(*(descendants(s) for s, _ in kept))
            for p, fd in pinned.items():
                try:
                    if p in under:
                        sent.add(p)
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has processes after stop' % run,
                  'stop it again, or end its processes by hand: they run under process %s'
                  % ', '.join(str(p) for p, _ in kept))


def lock(run):
    """Hold the run's lock until this command ends, so its wakes and stops take turns."""
    if not os.path.exists(os.path.join(STATE, run + '.json')):
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')
    try:
        fcntl.flock(os.open(os.path.join(STATE, run + '.lock'), os.O_RDONLY | os.O_CREAT, 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run,
                      'make OPENWIZ_HERMES_STATE (or ~/.local/state/openwiz-hermes) a folder you can write')


def saved(run, state=None):
    path = os.path.join(STATE, run + '.json')
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(path + '.new', path)
        return state
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def unsaved(run, turn, cmd):
    """A turn began but could not be saved: end it, and say the outcome is unknown, never retry."""
    try:
        end([turn], run)
    except Refused:
        raise Refused('run %s began a turn it could not save, and could not confirm the turn ended; its outcome is '
                      'unknown' % run, 'end process %d and everything under it by hand, and read the ticket for '
                      'what its agent did, before you %s it again' % (turn['supervisor'], cmd))
    raise Refused('run %s began a turn it could not save, so the driver ended it; its outcome is unknown' % run,
                  'read the ticket for what its agent did before you %s it again' % cmd)


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req, run = read(START), 'run-' + secrets.token_hex(6)
        if req['harness'] not in HARNESSES:
            raise Refused('Hermes cannot run harness ' + req['harness'], 'use one of: ' + ', '.join(HARNESSES))
        state = {'request': req, 'session': None, 'turns': [], 'stopped': False, 'starting': True}
        try:  # save the run before its turn starts: nowhere to keep it, nothing starts
            saved(run, state)
            os.close(os.open(os.path.join(STATE, run + '.lock'), os.O_WRONLY | os.O_CREAT, 0o600))
        except OSError:
            raise Refused('the driver cannot save runs in its state folder; nothing was started',
                          'make OPENWIZ_HERMES_STATE (or ~/.local/state/openwiz-hermes) a folder you can write')
        try:
            turn = launch(req, run, None, 1)
        except Refused:
            try:
                saved(run, dict(state, stopped=True))
            except OSError:
                pass
            raise
        try:
            saved(run, dict(state, session=turn['session'], turns=[turn], starting=False))
        except OSError:  # the turn began but its run is not saved: end it, and never say retry
            unsaved(run, turn, 'start')
        return {'run': run}
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        lock(run)
        state = saved(run)
        if cmd == 'stop':
            try:  # first, so no wake starts a turn meanwhile
                saved(run, dict(state, stopped=True))
                kept = True
            except OSError:
                kept = False
            end(state['turns'], run)  # whether or not that save worked
            for t in state['turns']:  # the turns' output, the agent's words, goes with the run
                try:
                    os.remove(t['log'])
                except OSError:
                    pass
            if not kept:
                raise Refused('run %s has ended, but the driver could not save that it is stopped' % run,
                              'make OPENWIZ_HERMES_STATE (or ~/.local/state/openwiz-hermes) a folder you can '
                              'write, then stop it again')
            return {'run': run, 'stopped': True}
        if state['stopped']:
            raise Refused('run %s is stopped' % run, 'start a new run')
        if state.get('starting'):
            raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
        # One agent per run: while its last turn runs, that agent is awake and reads the ticket itself.
        if state['turns'] and running(state['turns'][-1], run):
            return {'run': run, 'woke': True}
        try:  # a turn it could not save would be beyond a later wake's check: save first, or start nothing
            saved(run, state)
        except OSError:
            raise Refused('the driver cannot save run %s; nothing was started' % run,
                          'make OPENWIZ_HERMES_STATE (or ~/.local/state/openwiz-hermes) a folder you can write')
        turn = launch(state['request'], run, state['session'], len(state['turns']) + 1)
        try:
            saved(run, dict(state, turns=state['turns'] + [turn]))
        except OSError:
            unsaved(run, turn, 'wake')
        return {'run': run, 'woke': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    if len(sys.argv) > 3 and sys.argv[1] == '--turn':
        return supervise(sys.argv[2], sys.argv[3:])
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
