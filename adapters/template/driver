#!/usr/bin/env python3
"""A minimal OpenWiz driver (kernel/driver.v1.md). Copy this folder to adapters/<host>/ and adapt it.

Each turn of a run is a local process: `start` runs the first turn, `wake` another once the last one has
ended, `stop` ends everything the run started. A run is saved before its first turn starts.
Adapt `command` to your harness, and `launch`, `running` and `end` to your host. Linux; standard library only.
"""
import json, os, re, secrets, shutil, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_TEMPLATE_STATE') or os.path.expanduser('~/.local/state/openwiz-template')
VERSION = {'driver': 'template', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'run-[0-9a-f]{12}'}
GRACE = 10  # seconds a stopped process has to exit before it is killed


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    """The request on stdin, with exactly these fields, each valid, or Refused."""
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def command(req, woken):
    """Adapt: your harness's own signed-in command. Never add a login or a token."""
    what = 'You were woken: read the ticket again and carry on' if woken else 'Build the ticket'
    prompt = '%s: %s#%d, with the %s skill.' % (what, req['repository'], req['ticket'], req['skill'])
    return [req['harness'], '--model', req['model'], '-p', prompt]


def launch(req, run, woken):
    """Start one turn; return what `end` needs to stop it."""
    if not shutil.which(req['harness']):
        raise Refused('harness %s is not installed here' % req['harness'],
                      'install %s and sign in to it yourself, then start again' % req['harness'])
    try:
        return subprocess.Popen(command(req, woken), env=dict(os.environ, OPENWIZ_RUN=run), start_new_session=True,
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).pid
    except OSError as e:
        raise Refused('harness %s did not start: %s' % (req['harness'], e.strerror), 'check that it runs by hand')


def marked(run):
    """Every live process carrying this run's mark: its turns and anything they started."""
    mark, found = ('OPENWIZ_RUN=' + run).encode(), []
    for pid in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/environ' % pid, 'rb') as f:
                if mark in f.read().split(b'\0'):
                    found.append(int(pid))
        except OSError:
            pass
    return found


def running(pid, run):
    """Whether the turn `launch` returned is still running."""
    return pid in marked(run)


def end(pid, run):
    """Stop the run: every process with its mark, even after the turn `pid` has exited; answer once none is left."""
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, 2)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            left = marked(run)
            if not left:
                time.sleep(0.1)  # a process in the middle of exec shows no environment for a moment
                left = marked(run)
                if not left:
                    return
            for p in set(left) - sent:  # each once, as it appears: a turn's child started meanwhile too
                sent.add(p)
                try:  # pin the pid, then check its mark again, so a pid the system reused is never signalled
                    fd = os.pidfd_open(p)
                except OSError:
                    continue
                try:
                    if p in marked(run):
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has processes after stop' % run,
                  'stop it again, or end the processes that carry OPENWIZ_RUN=%s by hand' % run)


def saved(run, state=None):
    path = os.path.join(STATE, run + '.json')
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(path + '.new', path)
        return state
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req, run = read(START), 'run-' + secrets.token_hex(6)
        state = {'request': req, 'turns': [], 'stopped': False}
        try:  # save the run before its turn starts: nowhere to keep it, nothing starts
            saved(run, state)
        except OSError:
            raise Refused('the driver cannot save runs in its state folder; nothing was started',
                          'make OPENWIZ_TEMPLATE_STATE (or ~/.local/state/openwiz-template) a folder you can write')
        try:
            pid = launch(req, run, False)
        except Refused:
            saved(run, dict(state, stopped=True))
            raise
        try:
            saved(run, dict(state, turns=[pid]))
        except OSError:  # the turn began but its run is not saved: end it, and never say retry
            try:
                end(pid, run)
            except Refused:
                pass
            try:  # and forget the run, so no wake starts it again
                os.remove(os.path.join(STATE, run + '.json'))
            except OSError:
                pass
            raise Refused('run %s began but could not be saved, so the driver ended it; its outcome is unknown' % run,
                          'read the ticket for what its agent did, and end any process carrying OPENWIZ_RUN=%s, '
                          'before you start again' % run)
        return {'run': run}
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        state = saved(run)
        if cmd == 'stop':
            saved(run, dict(state, stopped=True))  # first, so no wake starts a turn meanwhile
            end(state['turns'][-1] if state['turns'] else 0, run)
            return {'run': run, 'stopped': True}
        if state['stopped']:
            raise Refused('run %s is stopped' % run, 'start a new run')
        # One agent per run: while its last turn runs, that agent is awake and reads the ticket itself.
        if not (state['turns'] and running(state['turns'][-1], run)):
            state['turns'].append(launch(state['request'], run, True))
            saved(run, state)
        return {'run': run, 'woke': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
