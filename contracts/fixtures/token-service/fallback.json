{
  "synthetic": true,
  "note": "GA3's and GA4's seam: one helper run. 'call' is what the pairing call returned; the token appears only in GH_TOKEN of the child that uses it.",
  "cases": [
    {
      "name": "a good answer",
      "service": "answer",
      "argv": [
        "room-cli",
        "mac",
        "run",
        "--stdin",
        "python3 -I '/synthetic/openwiz/tools/github-app/token-service.py' mint"
      ],
      "token": "synthetic-write-token",
      "call": {
        "exit": 0,
        "stdout": "<requests.json's good write answer>"
      },
      "out": {
        "identity": "openwiz[bot]",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing",
          "GH_TOKEN": "synthetic-write-token"
        },
        "stderr": ""
      }
    },
    {
      "name": "no service configured",
      "service": "not-configured",
      "call": null,
      "out": {
        "identity": "owner",
        "env": {},
        "stderr": ""
      }
    },
    {
      "name": "the owner's machine is unavailable",
      "service": "unreachable",
      "reason": "unreachable",
      "call": {
        "exit": 1,
        "stdout": "",
        "stderr": "Mac unavailable"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (unreachable); using the owner's GitHub account\n"
      }
    },
    {
      "name": "the owner's machine does not answer in 60 seconds",
      "service": "unreachable",
      "reason": "unreachable",
      "call": {
        "exit": null,
        "timeout": true
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (unreachable); using the owner's GitHub account\n"
      }
    },
    {
      "name": "the service is stopped",
      "service": "unreachable",
      "reason": "unreachable",
      "call": {
        "exit": 1,
        "stdout": "",
        "stderr": "<the service's stopped sentence>"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (unreachable); using the owner's GitHub account\n"
      }
    },
    {
      "name": "an answer that is not JSON",
      "service": "bad-answer",
      "reason": "bad-answer",
      "call": {
        "exit": 0,
        "stdout": "garbled"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (bad-answer); using the owner's GitHub account\n"
      }
    },
    {
      "name": "an answer wider than the request",
      "service": "bad-answer",
      "reason": "bad-answer",
      "call": {
        "exit": 0,
        "stdout": "<an answer naming another repository>"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (bad-answer); using the owner's GitHub account\n"
      }
    },
    {
      "name": "a repository outside the installation",
      "service": "refusal",
      "reason": "not-installed",
      "call": {
        "exit": 3,
        "stdout": "<requests.json's not-installed refusal>"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (not-installed); using the owner's GitHub account\n"
      }
    },
    {
      "name": "the service cannot reach GitHub",
      "service": "refusal",
      "reason": "unavailable",
      "call": {
        "exit": 1,
        "stdout": "<requests.json's unavailable refusal>"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (unavailable); using the owner's GitHub account\n"
      }
    },
    {
      "name": "a refresh that fails",
      "service": "unreachable",
      "reason": "unreachable",
      "call": {
        "exit": 1,
        "stdout": "",
        "stderr": "Mac not responding"
      },
      "out": {
        "identity": "owner",
        "env": {
          "OPENWIZ_TOKEN_SERVICE": "/synthetic/openwiz/tools/github-app/token-service.py",
          "OPENWIZ_TOKEN_SERVICE_ROUTE": "pairing"
        },
        "stderr": "openwiz: no openwiz[bot] token (unreachable); using the owner's GitHub account\n"
      }
    }
  ]
}
