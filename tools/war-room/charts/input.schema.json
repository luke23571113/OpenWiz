{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwiz.war-room.charts-input.v1",
  "title": "War room chart input v1 (WRD2, #630)",
  "description": "The prepared, validated and sanitized rows the build-time renderer draws. Structural only; prepare.py applies the cross-field rules in contract.md.",
  "type": "object",
  "required": ["schema", "built_at", "history", "figures"],
  "properties": {
    "schema": {"const": "openwiz.war-room.charts-input.v1"},
    "built_at": {"$ref": "#/$defs/time"},
    "history": {
      "type": "object",
      "required": ["samples", "v1", "v2", "first", "last"],
      "properties": {
        "samples": {"type": "integer"},
        "v1": {"type": "integer"},
        "v2": {"type": "integer"},
        "first": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "last": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}
      }
    },
    "figures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/figure"}}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"},
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f<>]{1,400}(?![\\s\\S])"},
    "key": {"type": "string", "pattern": "^[A-Za-z0-9_.:|-]{1,160}(?![\\s\\S])"},
    "figure": {
      "type": "object",
      "required": ["id", "kind", "title", "caption", "unit", "window", "domain", "series", "rows", "coverage", "gaps", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:00[a-e]|body-[a-z0-9-]{1,60})(?![\\s\\S])"},
        "kind": {"enum": ["daily-line", "daily-bar", "spans", "bars", "distribution", "limits", "readiness"]},
        "title": {"$ref": "#/$defs/text"},
        "caption": {"$ref": "#/$defs/text"},
        "unit": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
        "window": {"anyOf": [{"$ref": "#/$defs/window"}, {"type": "null"}]},
        "domain": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "series": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/series"}},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
        "coverage": {
          "type": "object",
          "required": ["observed", "expected", "missing"],
          "properties": {
            "observed": {"type": "integer"},
            "expected": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
            "missing": {"type": "array", "items": {"$ref": "#/$defs/key"}}
          }
        },
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    "window": {
      "type": "object",
      "required": ["since", "until", "timezone"],
      "properties": {
        "since": {"$ref": "#/$defs/time"},
        "until": {"$ref": "#/$defs/time"},
        "timezone": {"enum": ["UTC", "PST-fixed-UTC-08:00"]}
      }
    },
    "series": {
      "type": "object",
      "required": ["key", "label", "role"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "label": {"$ref": "#/$defs/text"},
        "role": {"enum": ["primary", "secondary", "reference", "older", "muted"]}
      }
    },
    "row": {
      "type": "object",
      "required": ["key", "series", "x", "x2", "y", "state", "text", "label"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "series": {"$ref": "#/$defs/key"},
        "x": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
        "x2": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "y": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "state": {"enum": ["known", "partial", "unavailable", "missing"]},
        "text": {"anyOf": [{"type": "string", "pattern": "^[a-z0-9_ -]{1,24}(?![\\s\\S])"}, {"type": "null"}]},
        "label": {"$ref": "#/$defs/text"}
      }
    },
    "source": {
      "type": "object",
      "required": ["slot", "metric", "path", "schema", "sha256", "evidence", "samples"],
      "properties": {
        "slot": {"$ref": "#/$defs/key"},
        "metric": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"},
        "schema": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "evidence": {"type": "array", "items": {"type": "string", "pattern": "^https://github\\.com/"}},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/time"}}
      }
    }
  }
}
